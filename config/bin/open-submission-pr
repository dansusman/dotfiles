#!/bin/bash

set -e

find_pr() {
    gh pr list --repo Ginger-Labs/Notability --state "$1" --search "Submission in:title" \
        --json number,title,url \
        --jq '[.[] | select(.title | test("^[0-9]+\\.[0-9]+\\.?[0-9]* Submission$"))] | sort_by(.number) | last | .url'
}

pr_url=$(find_pr open)
if [[ -z "$pr_url" ]]; then
    pr_url=$(find_pr all)
fi

if [[ -z "$pr_url" ]]; then
    echo "No submission PR found." >&2
    exit 1
fi

open "$pr_url"
