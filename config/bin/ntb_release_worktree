#!/usr/bin/env bash
# Check out the newest submission PR branch into a worktree and drop into it.
set -Eeuo pipefail

cd ~/Developer/notability/ || exit 1

echo "📋 Finding newest submission PR..."

find_pr() {
  gh pr list --repo Ginger-Labs/Notability --state "$1" --search "Submission in:title" \
    --json number,title,headRefName \
    --jq '[.[] | select(.title | test("^[0-9]+\\.[0-9]+\\.?[0-9]* Submission$"))] | sort_by(.number) | last // empty | "\(.number)\t\(.title)\t\(.headRefName)"'
}

PR=$(find_pr open)
if [ -z "$PR" ]; then
  PR=$(find_pr all)
fi

if [ -z "$PR" ]; then
  echo "❌ No submission PR found."
  exit 1
fi

PR_NUMBER=$(printf '%s' "$PR" | cut -f1)
PR_TITLE=$(printf '%s' "$PR" | cut -f2)
HEAD_REF=$(printf '%s' "$PR" | cut -f3)

echo "🎯 PR #$PR_NUMBER: $PR_TITLE ($HEAD_REF)"

WORKTREE="$HEAD_REF"

if [ -d "$WORKTREE" ]; then
  echo "♻️  Worktree '$WORKTREE' already exists, reusing."
  git -C "$WORKTREE" pull --ff-only || true
else
  echo "🌳 Creating worktree '$WORKTREE'"
  git fetch origin "$HEAD_REF"
  if git show-ref --verify --quiet "refs/heads/$HEAD_REF"; then
    git worktree add "$WORKTREE" "$HEAD_REF"
  else
    git worktree add --track -b "$HEAD_REF" "$WORKTREE" "origin/$HEAD_REF"
  fi
fi

cd "$WORKTREE" || exit 1

SESSION="release-pr-$PR_NUMBER"
tmux new-session -d -s "$SESSION" -c "$PWD" -n "code" "$SHELL" 2>/dev/null || true
tmux new-window  -t "$SESSION" -c "$PWD" -n "pr" "GLAMOUR_STYLE=light gh pr view $PR_NUMBER; $SHELL" 2>/dev/null || true
tmux select-window -t "$SESSION:code"

tmux switch-client -t "$SESSION" 2>/dev/null || sesh connect "$SESSION"
tmux kill-session -t "release" 2>/dev/null || true
