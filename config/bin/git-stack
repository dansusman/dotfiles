#!/bin/bash
# git-stack — stacked-branch helpers using plain git.
#
# Parent links live in git config (shared across worktrees in a bare-repo setup):
#   branch.<name>.parent  the branch this one is stacked on (e.g. origin/staging or susman/foo)
#   branch.<name>.base    sha of the parent tip this branch was last rebased onto;
#                         refreshed automatically whenever parent is an ancestor, so after
#                         the parent rebases it still marks the correct --onto boundary.
# Both are deleted automatically when the branch is deleted (git removes the branch.<name> section).
#
# Subcommands:
#   git stack                 tree of tracked branches + status + suggested next commands
#   git stack sync            refresh recorded bases (runs implicitly everywhere)
#   git stack parent [ref]    show/set/infer current branch's parent (--unset to clear)
#   git stack rbc [args]      rebase current branch onto its (possibly moved) parent
#   git stack rbu [args]      fetch + rebase -i origin/staging --autosquash --update-refs

set -u

ROOT="origin/staging"

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; BOLD=$'\033[1m'; RESET=$'\033[0m'

die() { echo "${RED}error:${RESET} $*" >&2; exit 1; }

current_branch() { git symbolic-ref --quiet --short HEAD; }

resolves() { git rev-parse --quiet --verify "$1^{commit}" >/dev/null; }

parent_of() { git config --get "branch.$1.parent"; }

base_of() { git config --get "branch.$1.base"; }

tracked_branches() {
    git config --get-regexp '^branch\..*\.parent$' 2>/dev/null |
        sed -e 's/^branch\.//' -e 's/\.parent .*$//'
}

children_of() {
    local b
    for b in $(tracked_branches); do
        [ "$(parent_of "$b")" = "$1" ] && echo "$b"
    done
}

# Refresh branch.<b>.base for every tracked branch: parent tip when the branch
# contains it, otherwise (if unset) the current merge-base — captured now, while
# it's still computable, in case the parent gets rewritten later.
# Idempotent; safe to run anytime.
sync_bases() {
    local b p
    for b in $(tracked_branches); do
        p=$(parent_of "$b")
        resolves "$b" && resolves "$p" || continue
        if git merge-base --is-ancestor "$p" "$b"; then
            git config "branch.$b.base" "$(git rev-parse "$p")"
        elif [ -z "$(base_of "$b")" ]; then
            git config "branch.$b.base" "$(git merge-base "$p" "$b")"
        fi
    done
}

# stale = parent tip no longer contained in branch (parent moved under it)
is_stale() {
    local p
    p=$(parent_of "$1") || return 1
    resolves "$p" || return 1
    ! git merge-base --is-ancestor "$p" "$1"
}

push_status() {
    local b=$1 u
    u=$(git rev-parse --quiet --verify "$b@{upstream}") || { echo "no-upstream"; return; }
    if [ "$u" = "$(git rev-parse "$b")" ]; then echo "pushed"; else echo "needs-push"; fi
}

# Best-guess parent: the ancestor branch tip closest to HEAD.
infer_parent() {
    local target=$1 best="" best_count=-1 b count
    for b in $(git for-each-ref --format='%(refname:short)' refs/heads) "$ROOT"; do
        [ "$b" = "$target" ] && continue
        git merge-base --is-ancestor "$b" "$target" 2>/dev/null || continue
        count=$(git rev-list --count "$b..$target")
        # ties (same tip commit): prefer a branch already participating in a stack
        if [ "$best_count" -lt 0 ] || [ "$count" -lt "$best_count" ] ||
           { [ "$count" -eq "$best_count" ] && git config --get "branch.$b.parent" >/dev/null 2>&1; }; then
            best=$b; best_count=$count
        fi
    done
    [ -n "$best" ] && echo "$best"
}

# Parent of branch, inferring + offering to save when unset.
ensure_parent() {
    local b=$1 p
    if p=$(parent_of "$b"); then echo "$p"; return 0; fi
    p=$(infer_parent "$b") || die "no parent set for $b and none inferable — run: git parent <branch>"
    echo "${YELLOW}no parent recorded for $b — inferred: ${BOLD}$p${RESET}" >&2
    printf 'save it? [Y/n] ' >&2
    local answer; read -r answer
    case "$answer" in n|N|no) die "aborted — set one with: git parent <branch>";; esac
    git config "branch.$b.parent" "$p"
    sync_bases
    echo "$p"
}

# ---------- tree rendering + suggestions ----------

SUGGESTIONS=()

print_node() {
    local b=$1 indent=$2 status marks=""
    if ! resolves "$b"; then
        echo "${indent}${RED}✗ $b (branch gone — children need: git parent <new-parent>)${RESET}"
        return
    fi
    if is_stale "$b"; then
        marks="${YELLOW}⟳ needs rebase onto $(parent_of "$b")${RESET}"
        SUGGESTIONS+=("git switch $b && git rbc")
    else
        marks="${GREEN}✓ in sync${RESET}"
    fi
    status=$(push_status "$b")
    case "$status" in
        needs-push)  marks="$marks ${YELLOW}↑ needs push${RESET}"
                     is_stale "$b" || SUGGESTIONS+=("git push --force-with-lease origin $b") ;;
        no-upstream) marks="$marks ${DIM}(no upstream)${RESET}" ;;
    esac
    local here=""
    [ "$b" = "${CURRENT:-}" ] && here="${BOLD}* ${RESET}"
    echo "${indent}${here}${b}  ${marks}"
}

print_tree() {
    local b=$1 indent=$2 c
    [ "${#indent}" -gt 40 ] && { echo "${indent}${RED}… (stack too deep — parent cycle?)${RESET}"; return; }
    print_node "$b" "$indent"
    for c in $(children_of "$b"); do
        print_tree "$c" "  $indent"
    done
}

show_stack() {
    SUGGESTIONS=()
    CURRENT=$(current_branch || true)
    echo "${DIM}$ROOT${RESET}"
    local b seen_roots=""
    for b in $(children_of "$ROOT"); do
        print_tree "$b" "  "
        seen_roots=1
    done
    # tracked branches whose parent chain doesn't reach ROOT (e.g. parent deleted)
    for b in $(tracked_branches); do
        local p; p=$(parent_of "$b")
        if [ "$p" != "$ROOT" ] && ! git config --get "branch.$p.parent" >/dev/null 2>&1 && ! resolves "$p"; then
            echo "  ${RED}✗ $b — parent '$p' gone; run: git switch $b && git parent <new-parent>${RESET}"
        fi
    done
    if [ -n "${CURRENT:-}" ] && ! parent_of "$CURRENT" >/dev/null; then
        echo "${DIM}(current branch $CURRENT untracked — git parent <branch> to add it)${RESET}"
    fi
    if [ ${#SUGGESTIONS[@]} -gt 0 ]; then
        echo
        echo "${BOLD}next:${RESET}"
        local s; for s in "${SUGGESTIONS[@]}"; do echo "  $s"; done
    fi
}

# ---------- subcommands ----------

cmd_parent() {
    local b; b=$(current_branch) || die "detached HEAD"
    case "${1:-}" in
        "")
            local p
            if p=$(parent_of "$b"); then
                echo "$p"
            else
                ensure_parent "$b" >/dev/null
            fi
            ;;
        --unset)
            git config --unset "branch.$b.parent" 2>/dev/null
            git config --unset "branch.$b.base" 2>/dev/null
            echo "unset parent of $b"
            ;;
        *)
            resolves "$1" || die "'$1' is not a valid ref"
            git config "branch.$b.parent" "$1"
            sync_bases
            echo "parent of $b -> $1"
            ;;
    esac
}

cmd_rbc() {
    local b p old_base
    b=$(current_branch) || die "detached HEAD"
    p=$(ensure_parent "$b") || exit 1
    resolves "$p" || die "parent '$p' no longer exists — run: git parent <new-parent>"
    if git merge-base --is-ancestor "$p" "$b"; then
        sync_bases
        echo "${GREEN}$b already contains $p — nothing to do${RESET}"
        exit 0
    fi
    old_base=$(base_of "$b")
    if [ -z "$old_base" ] || ! git merge-base --is-ancestor "$old_base" "$b" 2>/dev/null; then
        old_base=$(git merge-base --fork-point "$p" "$b") ||
            old_base=$(git merge-base "$p" "$b") ||
            die "cannot determine old base of $b — rebase manually once, then rerun git stack"
        echo "${DIM}(no recorded base; using $(git rev-parse --short "$old_base"))${RESET}"
    fi
    echo "rebasing $(git rev-list --count "$old_base..$b") commit(s) of $b onto $p"
    if git rebase --onto "$p" "$old_base" "$@"; then
        sync_bases
        echo
        show_stack
    else
        echo
        echo "${YELLOW}resolve conflicts, git rebase --continue, then run: git stack${RESET}" >&2
        exit 1
    fi
}

cmd_rbu() {
    echo "fetching..."
    git fetch || die "fetch failed"
    if git rebase -i "$ROOT" --autosquash --update-refs "$@"; then
        sync_bases
        echo
        show_stack
    else
        echo
        echo "${YELLOW}resolve conflicts, git rebase --continue, then run: git stack${RESET}" >&2
        exit 1
    fi
}

case "${1:-tree}" in
    tree)   sync_bases; show_stack ;;
    sync)   sync_bases; echo "bases refreshed" ;;
    parent) shift; cmd_parent "$@" ;;
    rbc)    shift; cmd_rbc "$@" ;;
    rbu)    shift; cmd_rbu "$@" ;;
    *)      die "unknown subcommand '$1' (tree|sync|parent|rbc|rbu)" ;;
esac
