#compdef git-stack

__git_stack_branches() {
    local -a branches
    branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes 2>/dev/null)"})
    _describe -t branches 'branch' branches
}

_git-stack() {
    local -a subcmds
    subcmds=(
        'tree:show stack tree, status, and suggested next commands'
        'sync:refresh recorded rebase bases'
        'parent:show or set the current branch'\''s stack parent'
        'rbc:rebase current branch onto its (possibly moved) parent'
        'rbu:fetch + rebase -i origin/staging --autosquash --update-refs'
    )
    if (( CURRENT == 2 )); then
        _describe -t commands 'git-stack subcommand' subcmds
    elif [[ $words[2] == parent ]]; then
        __git_stack_branches
    fi
}

_git-stack "$@"
